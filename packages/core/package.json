{
  "name": "@bakemono_san/verset-finder",
  "version": "0.1.0",
  "description": "Drop-in Quran verse finder: mic recitation -> surah:ayah. Vanilla TS core (headless).",
  "keywords": ["quran", "ayah", "verse-detection", "speech-recognition", "arabic", "whisper", "tarteel"],
  "author": "Bakemono San",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakemono-san/verset-finder.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bakemono-san/verset-finder#readme",
  "bugs": "https://github.com/bakemono-san/verset-finder/issues",
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --minify --out-dir dist",
    "build:data": "node scripts/build-index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "node -e \"const fs=require('fs');for(const f of ['dist/index.js']){try{const s=fs.statSync(f);console.log(f,(s.size/1024).toFixed(1)+'KB raw')}catch(e){console.log(f,'missing (run build first)'}}\" && gzip-size dist/index.js || gzip -c dist/index.js | wc -c"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
